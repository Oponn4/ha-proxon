{
  "config": {
    "step": {
      "user": {
        "title": "Set up Proxon FWT",
        "description": "Enter connection details for the Proxon RS485-to-LAN adapter. Room names will be read from the device automatically after the connection test.",
        "data": {
          "host": "IP Address / Hostname",
          "port": "Modbus TCP Port",
          "slave": "Modbus Slave ID",
          "has_t300": "T300 hot-water heat pump connected",
          "scan_interval": "Scan Interval (seconds, 10–120)",
          "filter_notification": "Filter Change Notification"
        },
        "data_description": {
          "host": "IP address of the USR RS485-LAN adapter (e.g. 10.42.20.2)",
          "port": "TCP port of the adapter – default 502, only change if configured differently",
          "slave": "Modbus device ID of the Proxon FWT – default 41, configurable on the device",
          "has_t300": "Enable if a Proxon T300 domestic hot-water heat pump is on the same RS485 bus. Adds all T300 sensors, switches and controls.",
          "filter_notification": "Show a notification in Home Assistant when the device filter needs to be replaced"
        }
      },
      "reconfigure": {
        "title": "Proxon FWT – Reconfigure Connection",
        "description": "Change connection parameters and re-discover rooms from the device.",
        "data": {
          "host": "IP Address / Hostname",
          "port": "Modbus TCP Port",
          "slave": "Modbus Slave ID",
          "has_t300": "T300 hot-water heat pump connected"
        },
        "data_description": {
          "host": "IP address of the USR RS485-LAN adapter",
          "port": "TCP port of the adapter – default 502",
          "slave": "Modbus device ID of the Proxon FWT – default 41",
          "has_t300": "Enable if a Proxon T300 domestic hot-water heat pump is on the same RS485 bus."
        }
      }
    },
    "error": {
      "cannot_connect": "Connection failed – check IP address, port and slave ID",
      "unknown": "Unknown error during connection setup"
    },
    "abort": {
      "already_configured": "This device is already configured",
      "reconfigure_successful": "Connection reconfigured, rooms updated"
    }
  },
  "options": {
